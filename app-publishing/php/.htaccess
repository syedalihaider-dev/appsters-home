# Block direct access to config and the bundled library
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^PHPMailer/ - [F,L]
</IfModule>
